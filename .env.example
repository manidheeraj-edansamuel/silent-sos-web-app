# ==============================================================================
# Silent SOS Emergency Web App - Root Environment Template
# ==============================================================================
# NOTE: This file is a template only. Do NOT store real credentials or secrets here.
# Copy this file or individual service templates to .env files during deployment.
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development

# --- Server Configuration ---
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
# Trust one reverse-proxy hop when hosted (Render/Railway).
# TRUST_PROXY=1

# --- Client Configuration ---
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:5000

# --- PostgreSQL & PostGIS Database Configuration ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=silent_sos
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# --- Managed Database (deployment) ---
# DATABASE_URL takes precedence over the discrete DATABASE_* values above.
# Use the provider's DIRECT (non-pooled) URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_SSL=true

# --- Public URL of a hosted deployment ---
# APP_BASE_URL=https://silent-sos.onrender.com
# CORS_ORIGIN=https://silent-sos.onrender.com

# --- JWT Authentication Settings (Step 3) ---
JWT_SECRET=your-secure-jwt-secret-placeholder
JWT_EXPIRES_IN=24h

# --- Planned Subsystems (For Future Milestones) ---
# REDIS_URL=redis://localhost:6379
# TWILIO_ACCOUNT_SID=your-twilio-sid-placeholder
# TWILIO_AUTH_TOKEN=your-twilio-token-placeholder
# TWILIO_FROM_NUMBER=+15550199000
