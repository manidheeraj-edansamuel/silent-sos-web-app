# ==============================================================================
# Silent SOS Emergency Web App - Root Environment Template
# ==============================================================================
# NOTE: This file is a template only. Do NOT store real credentials or secrets here.
# Copy this file or individual service templates to .env files during deployment.
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development

# --- Server Configuration ---
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Client Configuration ---
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:5000

# --- PostgreSQL & PostGIS Database Configuration ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=silent_sos
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# --- Planned Subsystems (For Future Milestones - Not Implemented in Step 2) ---
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-secure-jwt-secret-placeholder
# TWILIO_ACCOUNT_SID=your-twilio-sid-placeholder
# TWILIO_AUTH_TOKEN=your-twilio-token-placeholder
# TWILIO_PHONE_NUMBER=your-twilio-phone-placeholder
