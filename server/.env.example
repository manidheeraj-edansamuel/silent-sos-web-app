# ==============================================================================
# Silent SOS Server - Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to '.env' in this directory for local development.
# Never commit real credentials to version control.
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL & PostGIS Database Configuration ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=silent_sos
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# --- Database Connection Pool Settings (Optional defaults shown) ---
# DATABASE_POOL_MAX=20
# DATABASE_IDLE_TIMEOUT=30000
# DATABASE_CONNECT_TIMEOUT=3000
# DEBUG_SQL=false

# --- JWT Authentication Settings (Step 3) ---
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_EXPIRES_IN=24h

# --- Background Dispatch Queue (pg-boss) ---
# pg-boss stores jobs in the PostgreSQL database above; no Redis is required.
# QUEUE_POOL_MAX=5

# --- Email Notifications (Phase C) ---
# In development, leaving SMTP_HOST unset uses nodemailer's JSON transport
# (messages are serialized locally and never sent). Production requires SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Silent SOS" <no-reply@silent-sos.local>

# Public base URL used to build recipient tracking links in emails.
# Defaults to http://localhost:<PORT> when unset.
APP_BASE_URL=http://localhost:5000
